# ==============================================
# PAWSYNC FRONTEND - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values.
# Both of these are optional - Sign In / Sign Up work fine without them,
# the Google/Facebook buttons simply stay hidden or disabled until set,
# and each ID must match what you configured on the BACKEND (see
# backend/.env.example) for the two to actually talk to each other.
# ==============================================

# From https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application). Must match GOOGLE_CLIENT_ID in
# backend/.env, and http://localhost:5173 must be added under
# "Authorized JavaScript origins" on that credential.
VITE_GOOGLE_CLIENT_ID=

# From https://developers.facebook.com/apps (App ID). Must match
# FACEBOOK_APP_ID in backend/.env, and http://localhost:5173 must be added
# under the app's "App Domains" / Facebook Login "Valid OAuth Redirect URIs"
# settings.
VITE_FACEBOOK_APP_ID=
