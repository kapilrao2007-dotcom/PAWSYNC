# ==============================================
# PAWSYNC BACKEND - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values.
# Never commit your real .env file.
# ==============================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/pawsync

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Cloudinary (optional - falls back to local /uploads storage in dev if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google sign-in (optional - from https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" of type "Web application". "Sign in with Google"
# stays disabled/hidden on the frontend until this is set.
GOOGLE_CLIENT_ID=

# Facebook sign-in (optional - from https://developers.facebook.com/apps
# Create an app, add "Facebook Login", and copy its App ID / App Secret.
# App Secret is optional but recommended - it lets the server double-check
# the access token was really issued for this app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
